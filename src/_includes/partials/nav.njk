<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap site-head__inner">
    <a class="brand" href="/">
      <svg class="brand__mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
        <circle cx="14" cy="13" r="10" fill="var(--brand-100)" />
        <circle cx="20" cy="13" r="10" fill="var(--brand-500)" fill-opacity="0.85" />
        <circle cx="17" cy="21" r="10" fill="var(--brand-700)" fill-opacity="0.85" />
      </svg>
      <span class="brand__text">
        <span class="brand__name">{{ site.name }}</span>
        <span class="brand__tagline">{{ site.tagline }}</span>
      </span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="nav">
      <span class="visually-hidden">Menu</span>
      <svg width="24" height="24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"
        stroke="currentColor" stroke-width="2" fill="none"/></svg>
    </button>

    <nav id="nav" class="nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
        <li>
          <a href="{{ item.url }}"
             {% if page.url.startsWith(item.url) %}aria-current="page"{% endif %}>
            {{ item.label }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>