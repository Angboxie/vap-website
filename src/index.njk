<section class="hero">
  <div class="hero__media"></div>
  <div class="hero__overlay"></div>
  <div class="wrap hero__inner">
    <p class="hero__eyebrow">{{ site.tagline }}</p>
    <h1 class="hero__title">Unlocking commercial potential to <span class="hl">future proof value</span></h1>
  </div>

  <div class="stats__inner">
    <ul class="stats__list">
      <li class="stats__item">
        <span class="stats__number">—</span>
        <span class="stats__label">[Stat label 1]</span>
      </li>
      <li class="stats__item">
        <span class="stats__number">—</span>
        <span class="stats__label">[Stat label 2]</span>
      </li>
      <li class="stats__item">
        <span class="stats__number">—</span>
        <span class="stats__label">[Stat label 3]</span>
      </li>
      <li class="stats__item">
        <span class="stats__number">—</span>
        <span class="stats__label">[Stat label 4]</span>
      </li>
    </ul>
  </div>
</section>

<section class="story">
  <div class="wrap story__grid">
    <div class="story__head reveal">
      <p class="eyebrow">Our story</p>
      <h2 class="story__lede">Value Advisory Partners has over 15 years working across public and private sectors, delivering impact through precinct, development and resilience projects.</h2>
    </div>
    <div class="story__body reveal">
      <p>Our purpose is to meet decision makers' need for evidence-based, actionable advice to better plan and deliver adaptable places in our cities, regions and rural areas for today and for a climate resilient future.</p>
    </div>
  </div>
</section>

<section class="bands">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Our focus</p>
      <h2>[Section intro placeholder — a short line framing the three focus areas.]</h2>
    </div>

    <div class="band">
      <div class="band__media reveal reveal--from-left"></div>
      <div class="band__content reveal reveal--from-right">
        <p class="band__eyebrow">Focus area</p>
        <h3 class="band__title">Resilience and disaster risk reduction</h3>
        <p class="band__text">With CSIRO, developed the Enabling Resilience Investment Framework, an assessment and decision-making toolkit for reducing climate and disaster risk.</p>
        <a class="band__link" href="/what-we-do/">Learn more <span class="band__link-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="band band--reverse">
      <div class="band__media reveal reveal--from-right"></div>
      <div class="band__content reveal reveal--from-left">
        <p class="band__eyebrow">Focus area</p>
        <h3 class="band__title">Precincts, planning and development</h3>
        <p class="band__text">Success depends on an evidence base integrating top-down and bottom-up analysis, real data and forecasts.</p>
        <a class="band__link" href="/what-we-do/">Learn more <span class="band__link-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="band">
      <div class="band__media reveal reveal--from-left"></div>
      <div class="band__content reveal reveal--from-right">
        <p class="band__eyebrow">Focus area</p>
        <h3 class="band__title">Infrastructure, amenity and land use</h3>
        <p class="band__text">A system helping governments, agencies, universities and developers integrate transport, land use and delivery models.</p>
        <a class="band__link" href="/what-we-do/">Learn more <span class="band__link-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

