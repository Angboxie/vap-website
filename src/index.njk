---
layout: base.njk
---
<section class="hero">
  <div class="hero__media"></div>
  <div class="hero__overlay"></div>
  <div class="hero__fade" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <h1 class="hero__title">
      <span class="hero__mask"><span class="hero__line">Unlocking commercial</span></span>
      <span class="hero__mask"><span class="hero__line">potential to</span></span>
      <span class="hero__mask"><span class="hero__line hero__line--light">deliver lasting impact</span></span>
    </h1>
    <span class="hero__mask">
      <span class="hero__line hero__actions">
        <a class="hero__cta hero__cta--primary" href="/our-work/">See our work</a>
        <a class="hero__cta hero__cta--secondary" href="/get-in-touch/">Get in touch <span aria-hidden="true">→</span></a>
      </span>
    </span>
  </div>

  <div class="wrap hero__stats">
    <ul class="stats__list">
      <li class="stats__item">
        <span class="stats__number">—</span>
        <span class="stats__label">[Stat label 1]</span>
      </li>
      <li class="stats__item">
        <span class="stats__number">—</span>
        <span class="stats__label">[Stat label 2]</span>
      </li>
      <li class="stats__item">
        <span class="stats__number">—</span>
        <span class="stats__label">[Stat label 3]</span>
      </li>
      <li class="stats__item">
        <span class="stats__number">—</span>
        <span class="stats__label">[Stat label 4]</span>
      </li>
    </ul>
  </div>
</section>

<section class="story bg-brand50">
  <div class="wrap story__grid">
    <div class="story__text reveal reveal-converge--text">
      <p class="eyebrow">Our story</p>
      <h2 class="story__lead">Evidence-based, actionable advice for decision makers</h2>
      <p class="story__body">Our purpose is to help decision makers better plan and deliver adaptable places in our cities, regions and rural areas — for today and for a climate resilient future. Value Advisory Partners has over 15 years working across public and private sectors, delivering impact through precinct, development and resilience projects.</p>
      <div class="story__stat">
        <span class="story__stat-number">15+</span>
        <span class="story__stat-label">Years working across public and private sectors</span>
      </div>
      <a class="section-cta" href="/what-we-do/">See how we work <span aria-hidden="true">→</span></a>
    </div>
    <div class="story__media reveal reveal-converge--media" data-placeholder="Image: Value Advisory Partners at work"></div>
  </div>
</section>

<section class="focus bg-brand100">
  <div class="wrap">
    <div class="section-head reveal focus__head">
      <p class="eyebrow">Our focus</p>
      <h2>[Section intro placeholder — a short line framing the three focus areas.]</h2>
    </div>
  </div>

  <div class="focus__grid-outer">
    <div class="focus__grid stagger">
      <div class="focus__panel">
        <div class="focus__media reveal reveal-converge--media" style="background-image: url('/assets/img/resilience.JPG');"></div>
        <div class="focus__scrim" aria-hidden="true"></div>
        <div class="focus__panel-content reveal reveal-converge--text">
          <p class="focus__eyebrow">Focus area</p>
          <h3 class="focus__title">Resilience and disaster risk reduction</h3>
          <p class="focus__text">With CSIRO, developed the Enabling Resilience Investment Framework, an assessment and decision-making toolkit for reducing climate and disaster risk.</p>
          <a class="focus__more" href="/what-we-do/">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="focus__panel">
        <div class="focus__media reveal reveal-converge--media" style="background-image: url('/assets/img/precincts.JPG');"></div>
        <div class="focus__scrim" aria-hidden="true"></div>
        <div class="focus__panel-content reveal reveal-converge--text">
          <p class="focus__eyebrow">Focus area</p>
          <h3 class="focus__title">Precincts, planning and development</h3>
          <p class="focus__text">Success depends on an evidence base integrating top-down and bottom-up analysis, real data and forecasts.</p>
          <a class="focus__more" href="/what-we-do/">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="focus__panel">
        <div class="focus__media reveal reveal-converge--media" style="background-image: url('/assets/img/infrastructure.JPG');"></div>
        <div class="focus__scrim" aria-hidden="true"></div>
        <div class="focus__panel-content reveal reveal-converge--text">
          <p class="focus__eyebrow">Focus area</p>
          <h3 class="focus__title">Infrastructure, amenity and land use</h3>
          <p class="focus__text">A system helping governments, agencies, universities and developers integrate transport, land use and delivery models.</p>
          <a class="focus__more" href="/what-we-do/">Learn more <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="work bg-surface">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Selected work</p>
      <h2>[Section intro placeholder — a short line about the work shown below.]</h2>
    </div>

    <div class="work__grid stagger">
      <a class="work__item work__item--featured" href="/our-work/">
        <div class="work__media reveal reveal-converge--media" data-placeholder="Image: Gawler River Flood Management"></div>
        <div class="work__caption reveal reveal-converge--text">
          <h3>Gawler River Flood Management</h3>
          <p class="work__client">Department of Environment and Water SA</p>
          <p>[Paragraph placeholder — copy to come from the live site.]</p>
          <span class="work__link">View case study <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <a class="work__item" href="/our-work/">
        <div class="work__media reveal reveal-converge--media" data-placeholder="Image: Greenline"></div>
        <div class="work__caption reveal reveal-converge--text">
          <h3>Greenline</h3>
          <p class="work__client">City of Melbourne</p>
          <p>[Paragraph placeholder — copy to come from the live site.]</p>
          <span class="work__link">View case study <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <a class="work__item work__item--wide" href="/our-work/">
        <div class="work__media reveal reveal-converge--media" data-placeholder="Image: Deakin Burwood SRL Station Assessment"></div>
        <div class="work__caption reveal reveal-converge--text">
          <h3>Deakin Burwood SRL Station Assessment</h3>
          <p>[Paragraph placeholder — copy to come from the live site.]</p>
          <span class="work__link">View case study <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </div>

    <a class="section-cta" href="/our-work/">See all our work <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="approach bg-brand50">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Our approach</p>
      <h2>[Section intro placeholder — a short line about how VAP works.]</h2>
    </div>

    <div class="approach__diagram" aria-hidden="true">
      <div class="approach__hub reveal">
        <p>Practical tools to deliver integrated and optimised outcomes</p>
      </div>
      <div class="approach__nodes stagger">
        <div class="approach__node approach__node--1 reveal"><span>01</span></div>
        <div class="approach__node approach__node--2 reveal"><span>02</span></div>
        <div class="approach__node approach__node--3 reveal"><span>03</span></div>
        <div class="approach__node approach__node--4 reveal"><span>04</span></div>
      </div>
    </div>

    <div class="approach__grid stagger">
      <div class="approach__item reveal">
        <span class="approach__number">01</span>
        <h3>Joined-up Thinking</h3>
        <p>[Paragraph placeholder — copy to come from the live site.]</p>
      </div>
      <div class="approach__item reveal">
        <span class="approach__number">02</span>
        <h3>Rapid Assessment</h3>
        <p>[Paragraph placeholder — copy to come from the live site.]</p>
      </div>
      <div class="approach__item reveal">
        <span class="approach__number">03</span>
        <h3>Top-down, Bottom-up</h3>
        <p>[Paragraph placeholder — copy to come from the live site.]</p>
      </div>
      <div class="approach__item reveal">
        <span class="approach__number">04</span>
        <h3>Agile Decision Tools</h3>
        <p>[Paragraph placeholder — copy to come from the live site.]</p>
      </div>
    </div>

    <a class="section-cta" href="/what-we-do/">Explore what we do <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="values bg-brand100">
  <div class="wrap values__grid reveal">
    <div class="values__lead-col">
      <p class="eyebrow">Our values</p>
      <h2 class="values__lead">Collaboration and co-design with every client</h2>
      <div class="values__body">
        <p>At Value Advisory Partners we have a clear purpose and focus to maximise and sustain the value that can be obtained by public and private sector clients from their investments.</p>
        <p>We do this through a structured approach using data and evidence to build knowledge to inform sound decision making. We understand that value comes from multiple sources which can be integrated together to build a complete picture of the system to enable optimal value realisation and return.</p>
        <p>The hallmark of our work and approach is collaboration and co-design with our clients to identify, maximise and sustain the opportunities to create and extract value from their investments.</p>
      </div>
    </div>
    <div class="values__list stagger">
      <div class="values__item reveal">
        <span class="values__num" aria-hidden="true">01</span>
        <p>Creating and maintaining ongoing relationships built on trust</p>
      </div>
      <div class="values__item reveal">
        <span class="values__num" aria-hidden="true">02</span>
        <p>Empowering clients to find new solutions they hadn't considered</p>
      </div>
      <div class="values__item reveal">
        <span class="values__num" aria-hidden="true">03</span>
        <p>Designing innovative solutions</p>
      </div>
      <div class="values__item reveal">
        <span class="values__num" aria-hidden="true">04</span>
        <p>Enhancing benefits to the community and society</p>
      </div>
    </div>
  </div>
</section>

<section class="capabilities bg-surface">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Capabilities and industries</p>
    </div>

    <div class="capabilities__grid">
      <div class="capabilities__col reveal">
        <h3>Capabilities</h3>
        <ul class="stagger">
          <li>Forecasting and modelling</li>
          <li>Economic impact assessment</li>
          <li>Land use change</li>
          <li>Project funding and value capture mechanisms</li>
          <li>Dynamic delivery models</li>
          <li>Stakeholder engagement</li>
          <li>Geospatial analysis (GIS)</li>
        </ul>
      </div>
      <div class="capabilities__col reveal">
        <h3>Industries</h3>
        <ul class="stagger">
          <li>Local, state and commonwealth governments</li>
          <li>Residential and housing</li>
          <li>Employment</li>
          <li>Institutional</li>
          <li>Transport and land use</li>
          <li>Tourism and visitor economy</li>
          <li>First Nations and Traditional Owners Corporations</li>
          <li>Industry including utilities, ports and manufacturing</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="testimonial bg-brand100">
 <div class="testimonial__stack">
  <div class="wrap logos__inner reveal">
    <div class="logos__head">
      <p class="eyebrow">Who we've worked with</p>
      <h2>Trusted by agencies, institutions and industry across Australia</h2>
    </div>
    <div class="logos__row">
      <div class="logos__track">
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/csiro-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">CSIRO</span>
        </div>
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/uom-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">University of Melbourne</span>
        </div>
        <div class="logos__logo" tabindex="0">
          <span class="logos__mark" aria-hidden="true">VH</span>
          <span class="logos__name">Victorian Health Building Authority</span>
        </div>
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/vt-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">Victoria Department of Transport and Planning</span>
        </div>
        <div class="logos__logo" tabindex="0">
          <img class="logos__mark" src="/assets/img/udia-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">UDIA</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/csiro-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">CSIRO</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/uom-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">University of Melbourne</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <span class="logos__mark">VH</span>
          <span class="logos__name">Victorian Health Building Authority</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/vt-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">Victoria Department of Transport and Planning</span>
        </div>
        <div class="logos__logo" aria-hidden="true" tabindex="-1">
          <img class="logos__mark" src="/assets/img/udia-logo.webp" alt="" aria-hidden="true">
          <span class="logos__name">UDIA</span>
        </div>
      </div>
    </div>
  </div>

  <div class="testimonial__divider" aria-hidden="true"></div>

  <div class="wrap testimonial__grid reveal">
    <div class="testimonial__lead-col">
      <p class="testimonial__mark" aria-hidden="true">&ldquo;</p>
      <p class="eyebrow">What clients say</p>
    </div>

    <div class="carousel" data-carousel>
      <div class="carousel__viewport">
        <div class="carousel__track">
          {% for t in testimonials %}
          <blockquote class="carousel__slide{% if loop.first %} is-active{% endif %}" data-slide{% if not loop.first %} aria-hidden="true"{% endif %}>
            <p class="carousel__quote">{{ t.quote }}</p>
            <footer class="testimonial__attribution">{{ t.attribution }}</footer>
          </blockquote>
          {% endfor %}
        </div>
        <div class="visually-hidden" aria-live="polite" data-carousel-announcer></div>
      </div>

      {% if testimonials.length > 1 %}
      <div class="carousel__progress" role="tablist" aria-label="Testimonial navigation">
        {% for t in testimonials %}
        <button class="carousel__segment{% if loop.first %} is-active{% endif %}" type="button" role="tab" aria-label="Show testimonial {{ loop.index }}: {{ t.attribution }}" aria-selected="{% if loop.first %}true{% else %}false{% endif %}">
          <span class="carousel__segment-track" aria-hidden="true"><span class="carousel__segment-fill"></span></span>
          <span class="carousel__segment-label">{{ t.attribution }}</span>
        </button>
        {% endfor %}
      </div>
      {% endif %}

      <a class="section-cta" href="/our-work/">Read more client stories <span aria-hidden="true">→</span></a>
    </div>
  </div>
 </div>
</section>

<section class="cta bg-surface">
  <div class="wrap cta__inner reveal">
    <div class="cta__text">
      <h2>[Contact prompt heading placeholder]</h2>
      <p>[Paragraph placeholder — copy to come from the live site.]</p>
    </div>
    <a class="cta__link" href="/get-in-touch/">Get in touch <span aria-hidden="true">→</span></a>
  </div>
</section>
